{
  "name": "@bakery-framework/example",
  "version": "4.0.0",
  "private": true,
  "description": "Example application, and the end-to-end target for the framework.",
  "type": "module",
  "scripts": {
    "dev": "bun --smol run ../../packages/cli/src/index.ts --dev",
    "serve": "bun --smol run ../../packages/cli/src/index.ts",
    "db:sync": "bun --smol run ../../packages/orm/src/sync",
    "db:history": "bun --smol run ../../packages/orm/src/sync/history.ts",
    "db:rollback": "bun --smol run ../../packages/orm/src/sync/rollback.ts"
  },
  "dependencies": {
    "@bakery-framework/core": "workspace:*",
    "@bakery-framework/cli": "workspace:*",
    "@bakery-framework/orm": "workspace:*"
  },
  "devDependencies": {
    "@bakery-framework/plugin-dashboard": "workspace:*",
    "@bakery-framework/plugin-db-explorer": "workspace:*",
    "vue": "^3.5.38"
  }
}
