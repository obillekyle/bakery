.DAV
*/.DAV

.env

# An app's schema is app-owned and often generated, so it is not tracked.
# The bare pattern matches at any depth, which silently swallowed the starter
# app's schema too: `apps/starter/orm/index.ts` imports `./schema`, so a fresh
# clone failed `bun run typecheck` with TS2307 and CI would have failed on its
# very first run. The starter is a first-party fixture, not a user's app.
schema.ts
!apps/starter/orm/schema.ts

*.db
*.sqlite
*.sqlite3
*.db-*

cookies.txt

node_modules
dist
scratch

# The framework's two runtime directories (packages/core/src/core/bakery.ts).
# `.cache` is disposable — the framework deletes it wholesale on every version
# bump and dev<->prod switch. `bakery/` holds server.db and backups/ and is
# deliberately *not* hidden, so a `rm -rf .*` cannot reach it; the trailing
# slash keeps this to directories, so a file named `bakery` stays tracked.
.cache
bakery/

*.tsbuildinfo

# Local-only maintainer/agent context - not published.
/.claude/
/CLAUDE.md
/MONOREPO.md
/ORM-PLAN.md
