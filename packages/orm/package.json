{
  "name": "@bakery/orm",
  "version": "4.0.0",
  "description": "Bakery database layer: adapters, query builder, schema sync and backup.",
  "keywords": [
    "bakery",
    "bun",
    "orm",
    "database",
    "sqlite",
    "mysql",
    "postgres",
    "query-builder",
    "schema-migration"
  ],
  "author": "obillekyle",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obillekyle/bun-server.git",
    "directory": "packages/orm"
  },
  "homepage": "https://github.com/obillekyle/bun-server#readme",
  "bugs": "https://github.com/obillekyle/bun-server/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./orm": "./src/orm/index.ts",
    "./sync": "./src/sync/index.ts",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json",
    "./schema-registry": "./src/schema-registry.ts",
    "./schema-util": "./src/schema-util.ts",
    "./connection": "./src/connection.ts",
    "./backup": "./src/backup.ts",
    "./*": "./src/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "files": [
    "src",
    "templates",
    "!src/**/*.test.ts",
    "!src/tests"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@bakery/core": "workspace:^"
  }
}
