{
  "name": "@bakery-framework/cli",
  "version": "1.2.1",
  "description": "Bakery entry point and process supervision: mode dispatch, dev watcher, cluster.",
  "keywords": [
    "bakery",
    "bun",
    "cli",
    "dev-server",
    "hot-reload",
    "cluster"
  ],
  "author": "obillekyle",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obillekyle/bakery.git",
    "directory": "packages/cli"
  },
  "homepage": "https://bakery.okyle.dev",
  "bugs": "https://github.com/obillekyle/bakery/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "bakery": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/tests"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@bakery-framework/core": "workspace:^"
  },
  "peerDependencies": {
    "@bakery-framework/orm": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@bakery-framework/orm": {
      "optional": true
    }
  }
}
