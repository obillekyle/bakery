{
  "name": "@bakery/cli",
  "version": "4.0.0",
  "description": "Bakery entry point and process supervision: mode dispatch, dev watcher, cluster.",
  "keywords": [
    "bakery",
    "bun",
    "cli",
    "dev-server",
    "hot-reload",
    "cluster"
  ],
  "author": "obillekyle",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obillekyle/bun-server.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/obillekyle/bun-server#readme",
  "bugs": "https://github.com/obillekyle/bun-server/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "bakery": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/tests"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@bakery/core": "workspace:^",
    "@bakery/orm": "workspace:^"
  }
}
