{
  "name": "@bakery/cli",
  "version": "3.0.0",
  "description": "Bakery entry point and process supervision: mode dispatch, dev watcher, cluster.",
  "author": "obillekyle",
  "license": "CC0-1.0 & MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obillekyle/bun-server.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/obillekyle/bun-server#readme",
  "bugs": "https://github.com/obillekyle/bun-server/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
    "bakery": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@bakery/core": "workspace:*",
    "@bakery/orm": "workspace:*"
  }
}
