{
  "name": "@bakery/core",
  "version": "3.0.0",
  "description": "Bakery framework core: handlers, router, config, session, caches, logger, compiler.",
  "author": "obillekyle",
  "license": "CC0-1.0 & MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obillekyle/bun-server.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/obillekyle/bun-server#readme",
  "bugs": "https://github.com/obillekyle/bun-server/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./src/core/index.ts",
  "exports": {
    ".": "./src/core/index.ts",
    "./compiler": "./src/compiler/index.ts",
    "./core": "./src/core/index.ts",
    "./handlers": "./src/handlers/index.ts",
    "./logger": "./src/logger/index.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/common": "./src/utils/common/index.ts",
    "./utils/http": "./src/utils/http/index.ts",
    "./utils/isomorphic": "./src/utils/isomorphic/index.ts",
    "./types": "./src/types.d.ts",
    "./package.json": "./package.json",
    "./startup": "./src/startup.ts",
    "./tsconfig.app.json": "./tsconfig.app.json",
    "./session": "./src/session.ts",
    "./jsx": "./src/core/jsx.ts",
    "./plugins": "./src/plugins/routes.ts",
    "./*": "./src/*.ts",
    "./*.ts": "./src/*.ts"
  },
  "files": [
    "src",
    "tsconfig.app.json",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.38",
    "vue": "^3.5.38"
  }
}
