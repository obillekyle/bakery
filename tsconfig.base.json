{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["bun-types"],
    "paths": {
      "@bakery/core": ["./packages/core/src/core/index.ts"],
      "@bakery/core/*": ["./packages/core/src/*"],
      "@bakery/orm": ["./packages/orm/src/index.ts"],
      "@bakery/orm/*": ["./packages/orm/src/*"],
      "@bakery/cli": ["./packages/cli/src/index.ts"],
      "@bakery/cli/*": ["./packages/cli/src/*"],
      "@bakery/plugin-vue": ["./packages/plugins/vue/src/index.ts"],
      "@bakery/plugin-analytics": ["./packages/plugins/analytics/src/index.ts"],
      "@bakery/plugin-dashboard": ["./packages/plugins/dashboard/src/index.ts"],
      "@client/utils": ["./packages/core/src/client/utils"],
      "~/*": ["./apps/example/*"]
    }
  }
}
