{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "forceConsistentCasingInFileNames": true,
    "noPropertyAccessFromIndexSignature": false,
    "types": ["bun-types"],
    "paths": {
      "@bakery-framework/core": ["./packages/core/src/core/index.ts"],
      "@bakery-framework/core/*": ["./packages/core/src/*"],
      "@bakery-framework/orm": ["./packages/orm/src/index.ts"],
      "@bakery-framework/orm/*": ["./packages/orm/src/*"],
      "@bakery-framework/cli": ["./packages/cli/src/index.ts"],
      "@bakery-framework/cli/*": ["./packages/cli/src/*"],
      "@bakery-framework/plugin-vue": ["./packages/plugins/vue/src/index.ts"],
      "@bakery-framework/plugin-analytics": [
        "./packages/plugins/analytics/src/index.ts"
      ],
      "@bakery-framework/plugin-dashboard": [
        "./packages/plugins/dashboard/src/index.ts"
      ],
      "@bakery-framework/plugin-db-explorer": [
        "./packages/plugins/db-explorer/src/index.ts"
      ]
    }
  }
}
