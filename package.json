{
  "name": "bakery-monorepo",
  "version": "2.4.2",
  "private": true,
  "description": "A ridiculously fast, zero-config full-stack framework built on Bun.",
  "author": "obillekyle",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/plugins/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "cd apps/example && bun run dev",
    "serve": "cd apps/example && bun run serve",
    "db:sync": "cd apps/example && bun run db:sync",
    "db:history": "cd apps/example && bun run db:history",
    "db:rollback": "cd apps/example && bun run db:rollback",
    "release": "bunx cutver",
    "test": "bun test --preload ./packages/orm/src/tests/sweep-preload.ts ./packages ./tests",
    "typecheck": "bun scripts/typecheck.ts"
  },
  "devDependencies": {
    "bun-types": "^1.4.0",
    "cutver": "^2.6.1",
    "vue": "^3.5.38"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
