{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "types": ["bun-types"],
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "paths": {
      "@server/*": ["../../.server/*"],
      "@database/*": ["../../.server/database/*"],
      "@api/*": ["../../api/*"],
      "@plugins/*": ["../../.server/plugins/*"],
      "~/*": ["../../*"]
    }
  },
  "include": [
    "../../**/*.tsx",
    "../../.server/**/*.ts",
    "../../.server/global.d.ts"
  ],
  "exclude": ["../../.server/.cache/**/*", "../../node_modules"]
}
