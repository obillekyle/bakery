{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@client/*": [
        "../client/*"
      ]
    }
  },
  "include": [
    "../../**/*.ts",
    "../client/**/*.ts"
  ],
  "exclude": [
    "../**/*",
    "../../server.config.ts",
    "../../schema.ts",
    "../../api/**/*",
    "../../scratch/**/*.ts",
    "../../node_modules"
  ],
  "files": [
    "../client/globals.d.ts",
    "../client/livereload.ts",
    "../client/utils.ts"
  ]
}